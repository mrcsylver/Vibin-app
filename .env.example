# Copy this file to `.env` in the project root (same folder as App.tsx).
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.
# Restart `npx expo start` after changing any value.
#
# IMPORTANT: `.env` is gitignored, so EAS Build does NOT receive it. Before your
# first cloud build, push these values to EAS once:
#     eas env:push production --path .env
#     eas env:push preview    --path .env
#     eas env:push development --path .env

# Supabase → Project Settings → Data API → Project URL
# This is the PROJECT URL, not an API key. It must look exactly like
# https://<project-ref>.supabase.co — pasting a key here makes every request
# fail against a hostname that does not exist.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase → Project Settings → API Keys → anon / public key
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Spotify Developer Dashboard → your app → Client ID
# Use PKCE (no client secret in the mobile app).
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
