# Copy this file to `.env` in the project root (same folder as App.tsx).
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app bundle.
# Restart `npx expo start` after changing any value.

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Spotify Developer Dashboard → your app → Client ID
# Use PKCE (no client secret in the mobile app).
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID
